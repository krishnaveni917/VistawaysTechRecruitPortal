@model VistaWaysTechRecruitPortal.Models.Candidate
@{
    ViewData["Title"] = "Upload Resume";
    Layout = "~/Areas/Candidate/Views/Shared/_CandidateLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Upload Resume</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-upload me-2"></i>Select File
    </div>
    <div class="card-body">

        @if (!string.IsNullOrWhiteSpace(Model.ResumePath))
        {
            <p>Current resume: <a href="@Model.ResumePath" target="_blank">View current resume</a></p>
        }

        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Choose Resume File</label>
                <input type="file" name="resume" class="form-control" accept=".pdf,.doc,.docx" required />
                <div class="form-text">Accepted formats: PDF, DOC, DOCX. Maximum size: 5 MB.</div>
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-cloud-upload-alt me-2"></i>Upload
            </button>
        </form>
    </div>
</div>
