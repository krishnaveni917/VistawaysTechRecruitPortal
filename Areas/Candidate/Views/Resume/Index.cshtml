@model VistaWaysTechRecruitPortal.Models.Candidate
@{
    ViewData["Title"] = "My Resume";
    Layout = "~/Areas/Candidate/Views/Shared/_CandidateLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Resume</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <i class="fas fa-file-pdf me-2"></i>Current Resume
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ResumePath))
        {
            <div class="d-flex align-items-center justify-content-between mb-3 p-3 border rounded">
                <div>
                    <i class="fas fa-file-alt fa-2x text-primary me-3"></i>
                    <strong>Resume on file</strong>
                </div>
                <a href="@Model.ResumePath" target="_blank" class="btn btn-outline-primary">
                    <i class="fas fa-eye me-1"></i>View
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>You haven't uploaded a resume yet.
            </div>
        }

        <a asp-action="Upload" class="btn btn-primary">
            <i class="fas fa-upload me-2"></i>@(string.IsNullOrWhiteSpace(Model.ResumePath) ? "Upload Resume" : "Replace Resume")
        </a>
    </div>
</div>
