@model VistaWaysTechRecruitPortal.Areas.Candidate.Controllers.CandidateDashboardViewModel
@{
    ViewData["Title"] = "Candidate Dashboard";
    Layout = "~/Areas/Candidate/Views/Shared/_CandidateLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-3">Welcome, @Model.Candidate.FirstName!</h2>
        <p class="text-muted">Track your application progress and manage your profile</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Candidate ID</h6>
                    <h4 class="mb-0">@Model.Candidate.CandidateId</h4>
                    <small class="text-success">Your unique ID</small>
                </div>
                <div class="icon blue">
                    <i class="fas fa-id-card"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Applications</h6>
                    <h3 class="mb-0">@Model.TotalApplications</h3>
                    <small class="text-info">Total submitted</small>
                </div>
                <div class="icon purple">
                    <i class="fas fa-file-alt"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Pending Assessments</h6>
                    <h3 class="mb-0">@Model.PendingAssessments</h3>
                    <small class="text-warning">Awaiting completion</small>
                </div>
                <div class="icon orange">
                    <i class="fas fa-clipboard-list"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3 mb-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Interviews</h6>
                    <h3 class="mb-0">@Model.ScheduledInterviews</h3>
                    <small class="text-success">Scheduled</small>
                </div>
                <div class="icon green">
                    <i class="fas fa-comments"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Application Status -->
<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Application Status</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <span class="status-badge bg-@(GetStatusBadgeClass(Model.Candidate.RecruitmentStatus)) me-3">
                        @Model.Candidate.RecruitmentStatus
                    </span>
                    <small class="text-muted">Current recruitment stage</small>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-@(GetProgressClass(Model.Candidate.RecruitmentStatus))" 
                         style="width: @(GetProgressPercentage(Model.Candidate.RecruitmentStatus))%">
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Registration Date: @Model.Candidate.RegistrationDate.ToString("MMM dd, yyyy")</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-area="Candidate" asp-controller="Profile" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-user me-2"></i>View Profile
                    </a>
                    <a asp-area="Candidate" asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-briefcase me-2"></i>Browse Jobs
                    </a>
                    <a asp-area="Candidate" asp-controller="Applications" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-file-alt me-2"></i>My Applications
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Registered" => "primary",
            "Profile Under Review" => "warning",
            "Assessment Invited" => "info",
            "Assessment In Progress" => "info",
            "Assessment Completed" => "secondary",
            "Assessment Terminated" => "danger",
            "Shortlisted For Interview" => "secondary",
            "Documents Uploaded" => "dark",
            "Documents Verified" => "dark",
            "Offer Generated" => "success",
            "Offer Accepted" => "success",
            "Onboarding Started" => "success",
            "Rejected" => "danger",
            _ => "secondary"
        };
    }

    string GetProgressClass(string status)
    {
        return status switch
        {
            "Registered" => "primary",
            "Profile Under Review" => "warning",
            "Assessment Invited" => "info",
            "Assessment In Progress" => "info",
            "Assessment Completed" => "secondary",
            "Assessment Terminated" => "danger",
            "Shortlisted For Interview" => "secondary",
            "Documents Uploaded" => "dark",
            "Documents Verified" => "dark",
            "Offer Generated" => "success",
            "Offer Accepted" => "success",
            "Onboarding Started" => "success",
            _ => "secondary"
        };
    }

    int GetProgressPercentage(string status)
    {
        return status switch
        {
            "Registered" => 15,
            "Profile Under Review" => 30,
            "Assessment Invited" => 40,
            "Assessment In Progress" => 50,
            "Assessment Completed" => 60,
            "Assessment Terminated" => 50,
            "Shortlisted For Interview" => 70,
            "Documents Uploaded" => 80,
            "Documents Verified" => 85,
            "Offer Generated" => 95,
            "Offer Accepted" => 100,
            "Onboarding Started" => 100,
            _ => 10
        };
    }
}
