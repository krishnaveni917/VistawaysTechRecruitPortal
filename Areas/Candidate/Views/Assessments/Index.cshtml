@model IEnumerable<VistaWaysTechRecruitPortal.Models.AssessmentInvitation>
@{
    ViewData["Title"] = "My Assessments";
    Layout = "~/Areas/Candidate/Views/Shared/_CandidateLayout.cshtml";
    var results = ViewBag.Results as List<VistaWaysTechRecruitPortal.Models.AssessmentResult> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Assessments</h2>
</div>

<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-clipboard-list me-2"></i>Assessment Invitations
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Sent Date</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in Model)
                        {
                            <tr>
                                <td>@invite.SentDate.ToString("dd-MMM-yyyy")</td>
                                <td>@invite.ExpiryDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    @if (invite.IsCompleted)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (!invite.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else if (invite.ExpiryDate < DateTime.Now)
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!invite.IsCompleted && invite.IsActive && invite.ExpiryDate >= DateTime.Now)
                                    {
                                        <a asp-action="Take" asp-route-id="@invite.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-pen"></i> Start Assessment
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle me-2"></i>You haven't received any assessment invitations yet.
            </div>
        }
    </div>
</div>

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <i class="fas fa-chart-bar me-2"></i>My Results
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            <i class="fas fa-info-circle me-1"></i>
            Scores are reviewed by our recruitment team - you'll be contacted directly with next steps.
        </p>
        @if (results.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Submitted On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in results)
                        {
                            <tr>
                                <td>@r.SubmittedOn.ToString("dd-MMM-yyyy HH:mm")</td>
                                <td>
                                    @if (r.WasTerminatedForViolation)
                                    {
                                        <span class="badge bg-dark">Ended Early</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle me-2"></i>No assessment results yet.
            </div>
        }
    </div>
</div>
