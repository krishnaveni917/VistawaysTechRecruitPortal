@model IEnumerable<VistaWaysTechRecruitPortal.Models.AssessmentQuestion>

@{
    ViewData["Title"] = "Assessment Questions";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center bg-warning">
        <h4>Assessment Questions</h4>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm">Add Question</a>
            <a asp-action="Invitations" class="btn btn-info btn-sm">Invitations</a>
            <a asp-action="Results" class="btn btn-success btn-sm">Results</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Marks</th>
                    <th>Correct Answer</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Question.Substring(0, Math.Min(item.Question.Length, 50))...</td>
                        <td>@item.Marks</td>
                        <td>@item.CorrectAnswer</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>