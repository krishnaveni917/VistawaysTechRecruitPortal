@model VistaWaysTechRecruitPortal.Models.Interview

@{
    ViewData["Title"] = "Delete Interview";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-danger text-white">
        <h4>Delete Interview</h4>
    </div>
    <div class="card-body">
        <h3>Are you sure you want to delete this interview?</h3>
        <div>
            <dl class="row">
                <dt class="col-sm-3">Candidate</dt>
                <dd class="col-sm-9">@Model.Candidate?.FirstName @Model.Candidate?.LastName</dd>
                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.InterviewType</dd>
                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.InterviewDate.ToString("yyyy-MM-dd")</dd>
                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@Model.InterviewTime</dd>
                <dt class="col-sm-3">Mode</dt>
                <dd class="col-sm-9">@Model.InterviewMode</dd>
                <dt class="col-sm-3">Interviewer</dt>
                <dd class="col-sm-9">@Model.Interviewer</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
