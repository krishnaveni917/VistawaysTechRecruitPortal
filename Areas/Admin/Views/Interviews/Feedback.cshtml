@model VistaWaysTechRecruitPortal.Models.Interview

@{
    ViewData["Title"] = "Interview Feedback";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-info text-white">
        <h4>Interview Feedback</h4>
    </div>
    <div class="card-body">
        <form asp-action="Feedback" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Feedback" class="form-label">Feedback</label>
                <textarea asp-for="Feedback" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Feedback" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rating" class="form-label">Rating (1-5)</label>
                <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select" required>
                    <option value="Completed">Completed Pending Decision</option>
                    <option value="Selected">Selected</option>
                    <option value="Rejected">Rejected</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsSelected" class="form-check-input" type="checkbox" />
                <label asp-for="IsSelected" class="form-check-label">Candidate Selected for Next Round/Offer</label>
            </div>
            <button type="submit" class="btn btn-primary">Submit Feedback</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
