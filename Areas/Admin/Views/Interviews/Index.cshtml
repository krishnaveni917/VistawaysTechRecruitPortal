@model IEnumerable<VistaWaysTechRecruitPortal.Models.Interview>

@{
    ViewData["Title"] = "Interviews";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center bg-info text-white">
        <h4>Interviews</h4>
        <a asp-action="Schedule" class="btn btn-light btn-sm">Schedule Interview</a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Candidate</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CandidateId</td>
                        <td>@item.InterviewType</td>
                        <td>@item.InterviewDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.InterviewTime</td>
                        <td>@item.InterviewMode</td>
                        <td>
                            @switch (item.Status)
                            {
                                case "Scheduled":
                                    <span class="badge bg-primary">Scheduled</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-success">Completed</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Feedback" asp-route-id="@item.Id" class="btn btn-sm btn-info">Feedback</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>