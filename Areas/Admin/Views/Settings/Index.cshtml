@{
    ViewData["Title"] = "Settings";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header bg-dark text-white">
        <h4>Settings</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-body text-center">
                        <i class="fas fa-envelope fa-3x text-primary mb-3"></i>
                        <h5>Email Settings</h5>
                        <p class="text-muted">Configure email server settings</p>
                        <a asp-action="EmailSettings" class="btn btn-primary">Configure</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-body text-center">
                        <i class="fas fa-cogs fa-3x text-success mb-3"></i>
                        <h5>System Settings</h5>
                        <p class="text-muted">Manage system configuration</p>
                        <a asp-action="SystemSettings" class="btn btn-success">Configure</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-body text-center">
                        <i class="fas fa-users-cog fa-3x text-warning mb-3"></i>
                        <h5>Role Management</h5>
                        <p class="text-muted">Manage user roles and permissions</p>
                        <a asp-action="RoleManagement" class="btn btn-warning">Manage</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>