@model IEnumerable<VistaWaysTechRecruitPortal.Models.Candidate>

@{
    ViewData["Title"] = "Candidates";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white d-flex justify-content-between">

        <h4>Candidate Management</h4>

        <form method="get">

            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search Candidate..." />

        </form>

    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>

                <tr>

                    <th>ID</th>

                    <th>Name</th>

                    <th>Email</th>

                    <th>Qualification</th>

                    <th>Resume</th>

                    <th>Status</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    <tr>

                        <td>@item.CandidateId</td>

                        <td>@item.FirstName @item.LastName</td>

                        <td>@item.Email</td>

                        <td>@item.Qualification</td>

                        <td>

                            @if (!string.IsNullOrWhiteSpace(item.ResumePath))
                            {
                                <a href="@item.ResumePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-file-download"></i> View
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }

                        </td>

                        <td>

                            <span class="badge bg-success">

                                @item.RecruitmentStatus

                            </span>

                        </td>

                        <td>

                            <a href="/Admin/Candidates/Details/@item.Id"
                               class="btn btn-primary btn-sm">

                                View

                            </a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>