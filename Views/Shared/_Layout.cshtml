<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - VistaWays Tech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/custom.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/corporate.css" asp-append-version="true" />

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container">

            <a class="navbar-brand fw-bold d-flex align-items-center"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.PNG"
                     width="45"
                     class="me-2" />

                <span class="brand-text-group">
                    <span class="brand-name">VistaWays Tech</span>
                    <span class="brand-tagline">Integration . Innovation . Impact</span>
                </span>

            </a>

            <button class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Services">
                            Services
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Careers">
                            Careers
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

                    <li class="nav-item ms-3">

                        <a class="btn btn-light"
                           asp-area="Candidate"
                           asp-controller="Account"
                           asp-action="Login">

                            Candidate Login

                        </a>

                    </li>

                    <li class="nav-item ms-2">

                        <a class="btn btn-warning"
                           asp-controller="Otp"
                           asp-action="RegisterEmailOtp">

                            Register

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="page-body">

        @RenderBody()

    </div>

    <footer class="bg-dark text-white mt-5">

        <div class="container py-4">

            <div class="row">

                <div class="col-md-4">

                    <h5>VistaWays Tech</h5>

                    <p>

                        Building Careers.

                        Creating Opportunities.

                    </p>

                </div>

                <div class="col-md-4">

                    <h5>

                        Quick Links

                    </h5>

                    <ul class="list-unstyled">

                        <li><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Home</a></li>

                        <li><a asp-controller="Home" asp-action="About" class="text-white text-decoration-none">About</a></li>

                        <li><a asp-controller="Home" asp-action="Careers" class="text-white text-decoration-none">Careers</a></li>

                        <li><a asp-controller="Home" asp-action="Contact" class="text-white text-decoration-none">Contact</a></li>

                    </ul>

                </div>

                <div class="col-md-4">

                    <h5>

                        Contact

                    </h5>

                    <p>

                        Email :

                        hr@vistawaystech.com

                    </p>

                    <p>

                        Phone :

                        +91 9876543210

                    </p>

                </div>

            </div>

            <hr />

            <p class="text-center">

                © 2026 VistaWays Tech

                All Rights Reserved.

            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
