@{
    ViewData["Title"] = "Assessment Submitted";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <i class="fas fa-check-circle text-success" style="font-size:64px;"></i>
            <h2 class="mt-3">Thank You</h2>
            <p class="lead">Thank you for completing the assessment. Your responses have been recorded.</p>
            <p class="text-muted">You have been signed out for security. Our team will review your submission and be in touch with next steps.</p>

            <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">
                Return to Login
            </a>
        </div>
    </div>
</div>
