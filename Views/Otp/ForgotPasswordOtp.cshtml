@using VistaWaysTechRecruitPortal.ViewModels
@model EmailRegistrationViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="form-page forgot-password-page">
    <div class="page-heading">
        <div>
            <p class="eyebrow">Password Reset</p>
            <h1>Reset Your Password</h1>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="form-card email-card">
        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-controller="Otp" asp-action="ForgotPasswordOtp" method="post">
            <div class="email-instructions">
                <p>Enter your registered email address. We'll send you a 6-digit OTP to verify your identity before resetting your password.</p>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="your.email@example.com" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">Send OTP</button>
            </div>

            <div class="login-link">
                <p>Remember your password?</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Login</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
