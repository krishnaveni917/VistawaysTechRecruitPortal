@using VistaWaysTechRecruitPortal.ViewModels
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="brand-mark">
            <img src="~/images/logo.PNG" alt="VistaWays Tech" />
        </div>
        <h1>Create New Password</h1>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="ResetPassword" method="post">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label">New password</label>
                <input asp-for="Password" class="form-control form-control-lg" />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Reset Password</button>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
