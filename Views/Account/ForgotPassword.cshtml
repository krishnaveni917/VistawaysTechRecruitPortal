@using VistaWaysTechRecruitPortal.ViewModels
@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="brand-mark">
            <img src="~/images/logo.PNG" alt="VistaWays Tech" />
        </div>
        <h1>Reset Candidate Password</h1>
        <p class="auth-copy">Enter your Candidate ID and registered email. We will send a secure reset link.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="CandidateId" class="form-label">Candidate ID</label>
                <input asp-for="CandidateId" class="form-control form-control-lg" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Registered email</label>
                <input asp-for="Email" class="form-control form-control-lg" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Send Reset Link</button>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
