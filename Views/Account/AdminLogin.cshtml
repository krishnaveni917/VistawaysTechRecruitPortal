@using VistaWaysTechRecruitPortal.ViewModels
@model AdminLoginViewModel

@{
    ViewData["Title"] = "Admin Login";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="brand-mark">
            <img src="~/images/logo.PNG" alt="VistaWays Tech" />
        </div>
        <h1>Admin Console</h1>
        <p class="auth-copy">Sign in with your VistaWays Tech administrator email and password.</p>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="AdminLogin" method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Admin email</label>
                <input asp-for="Email" class="form-control form-control-lg" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control form-control-lg" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Open Admin Dashboard</button>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
