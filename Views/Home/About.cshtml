@{
    ViewData["Title"] = "About Us";
}

<main class="corporate-page">
    <!-- Hero Section -->
    <section class="corporate-hero">
        <div class="hero-content">
            <p class="eyebrow">About VistaWays Tech</p>
            <h1>Building the Future of Technology Recruitment</h1>
            <p>
                VistaWays Tech is a leading technology recruitment company dedicated to connecting exceptional talent with innovative organizations. 
                We bring candidate registration, verification, assessment, interviews, document review, and offer workflows into one organized recruitment experience.
            </p>
            <div class="hero-stats">
                <div class="stat-item">
                    <strong>5000+</strong>
                    <span>Candidates Placed</span>
                </div>
                <div class="stat-item">
                    <strong>200+</strong>
                    <span>Partner Companies</span>
                </div>
                <div class="stat-item">
                    <strong>50+</strong>
                    <span>Global Locations</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="corporate-band">
        <div class="section-heading">
            <p class="eyebrow">Our Purpose</p>
            <h2>Mission & Vision</h2>
        </div>

        <div class="mission-vision-grid">
            <article class="mission-card">
                <div class="card-icon">🎯</div>
                <h3>Our Mission</h3>
                <p>To revolutionize the recruitment industry by providing a transparent, efficient, and candidate-centric platform that empowers both job seekers and employers to achieve their goals.</p>
            </article>
            <article class="mission-card">
                <div class="card-icon">🚀</div>
                <h3>Our Vision</h3>
                <p>To become the world's most trusted technology recruitment partner, known for innovation, integrity, and exceptional outcomes for all stakeholders.</p>
            </article>
            <article class="mission-card">
                <div class="card-icon">💡</div>
                <h3>Our Values</h3>
                <p>Transparency, Excellence, Innovation, Integrity, and People-First approach guide everything we do at VistaWays Tech.</p>
            </article>
        </div>
    </section>

    <!-- What We Stand For -->
    <section class="corporate-band corporate-band--muted">
        <div class="section-heading">
            <p class="eyebrow">What We Stand For</p>
            <h2>Professional Recruitment for Modern Teams</h2>
        </div>

        <div class="corporate-grid">
            <article class="corporate-tile">
                <div class="tile-icon">👤</div>
                <h3>Candidate-First Process</h3>
                <p>Clear steps, secure verification, and status-driven hiring journeys help candidates know what comes next at every stage.</p>
            </article>
            <article class="corporate-tile">
                <div class="tile-icon">📊</div>
                <h3>Reliable Evaluation</h3>
                <p>Assessments, profile review, interviews, and document checks support consistent and fair hiring decisions.</p>
            </article>
            <article class="corporate-tile">
                <div class="tile-icon">👁️</div>
                <h3>Operational Visibility</h3>
                <p>Recruiters can track applications, schedule interviews, verify documents, and prepare offers from one unified portal.</p>
            </article>
            <article class="corporate-tile">
                <div class="tile-icon">🔒</div>
                <h3>Security & Privacy</h3>
                <p>Enterprise-grade security measures protect candidate data and ensure compliance with global privacy standards.</p>
            </article>
        </div>
    </section>

    <!-- Our Approach -->
    <section class="corporate-band">
        <div class="section-heading">
            <p class="eyebrow">Our Approach</p>
            <h2>Designed Like an Enterprise Hiring Platform</h2>
        </div>

        <div class="journey-steps">
            <div class="journey-step">
                <div class="step-icon">📧</div>
                <strong>1</strong>
                <h3>Verify</h3>
                <p>Email-first registration with OTP verification protects candidate identity and keeps communication clean and secure.</p>
            </div>
            <div class="journey-step">
                <div class="step-icon">📝</div>
                <strong>2</strong>
                <h3>Evaluate</h3>
                <p>Structured education, resume, assessment, and interview data helps reviewers compare candidates fairly and objectively.</p>
            </div>
            <div class="journey-step">
                <div class="step-icon">🤝</div>
                <strong>3</strong>
                <h3>Decide</h3>
                <p>Recruitment statuses keep every stage visible from profile review to offer generation, ensuring transparency.</p>
            </div>
            <div class="journey-step">
                <div class="step-icon">🎉</div>
                <strong>4</strong>
                <h3>Onboard</h3>
                <p>Document verification and offer workflows move selected candidates smoothly toward joining the organization.</p>
            </div>
        </div>
    </section>

    <!-- Leadership Team -->
    <section class="corporate-band corporate-band--muted">
        <div class="section-heading">
            <p class="eyebrow">Leadership</p>
            <h2>Meet Our Leadership Team</h2>
        </div>

        <div class="team-grid">
            <article class="team-card">
                <div class="team-photo">
                    <div class="photo-placeholder">CEO</div>
                </div>
                <h3>John Smith</h3>
                <p class="team-role">Chief Executive Officer</p>
                <p class="team-bio">20+ years in technology recruitment and HR leadership.</p>
            </article>
            <article class="team-card">
                <div class="team-photo">
                    <div class="photo-placeholder">CTO</div>
                </div>
                <h3>Sarah Johnson</h3>
                <p class="team-role">Chief Technology Officer</p>
                <p class="team-bio">Expert in building scalable recruitment platforms.</p>
            </article>
            <article class="team-card">
                <div class="team-photo">
                    <div class="photo-placeholder">COO</div>
                </div>
                <h3>Michael Chen</h3>
                <p class="team-role">Chief Operations Officer</p>
                <p class="team-bio">Specialist in operational excellence and process optimization.</p>
            </article>
            <article class="team-card">
                <div class="team-photo">
                    <div class="photo-placeholder">CHRO</div>
                </div>
                <h3>Emily Davis</h3>
                <p class="team-role">Chief Human Resources Officer</p>
                <p class="team-bio">Passionate about candidate experience and talent development.</p>
            </article>
        </div>
    </section>

    <!-- Global Presence -->
    <section class="corporate-band">
        <div class="section-heading">
            <p class="eyebrow">Global Presence</p>
            <h2>Where We Operate</h2>
        </div>

        <div class="locations-grid">
            <div class="location-item">
                <strong>🇮🇳 India</strong>
                <p>Hyderabad (HQ), Bangalore, Chennai, Delhi, Mumbai</p>
            </div>
            <div class="location-item">
                <strong>🇺🇸 United States</strong>
                <p>San Francisco, New York, Seattle, Austin</p>
            </div>
            <div class="location-item">
                <strong>🇬🇧 United Kingdom</strong>
                <p>London, Manchester, Edinburgh</p>
            </div>
            <div class="location-item">
                <strong>🇨🇦 Canada</strong>
                <p>Toronto, Vancouver, Montreal</p>
            </div>
            <div class="location-item">
                <strong>🇦🇺 Australia</strong>
                <p>Sydney, Melbourne</p>
            </div>
            <div class="location-item">
                <strong>🇸🇬 Singapore</strong>
                <p>Singapore</p>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-band">
        <div>
            <p class="eyebrow">Join Our Team</p>
            <h2>Ready to Build Your Career with VistaWays Tech?</h2>
        </div>
        <a class="btn btn-warning btn-lg" asp-controller="Otp" asp-action="RegisterEmailOtp">Start Your Application</a>
    </section>
</main>
