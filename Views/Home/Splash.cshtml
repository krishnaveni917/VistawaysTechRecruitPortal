@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VistaWays Tech</title>
    <meta http-equiv="refresh" content="3;url=@Url.Action("Index", "Home")">
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body class="splash-body">
    <main class="splash-stage">
        <div class="logo-animation" aria-label="VistaWays Tech logo animation">
            <span class="logo-orbit logo-orbit-one"></span>
            <span class="logo-orbit logo-orbit-two"></span>
            <span class="logo-spark logo-spark-one"></span>
            <span class="logo-spark logo-spark-two"></span>
            <img src="~/images/logo.PNG" alt="VistaWays Tech" />
        </div>
        <p class="splash-kicker">VistaWays Tech</p>
        <p class="splash-tagline">Integration . Innovation . Impact</p>
        <h1>Recruitment Portal</h1>
        <p class="splash-copy">Secure hiring workflow for candidates, assessments, documents, offers, and onboarding.</p>
        <div class="splash-loader" aria-hidden="true"></div>
    </main>
</body>
</html>
