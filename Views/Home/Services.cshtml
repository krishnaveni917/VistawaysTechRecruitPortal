@{
    ViewData["Title"] = "Our Services";
}

<main class="corporate-page">
    <!-- Hero Section -->
    <section class="corporate-hero">
        <div class="hero-content">
            <p class="eyebrow">Our Services</p>
            <h1>Comprehensive Recruitment Solutions</h1>
            <p>
                VistaWays Tech offers end-to-end recruitment services designed to connect exceptional talent with leading organizations. 
                From candidate sourcing to onboarding, we provide comprehensive solutions for modern hiring needs.
            </p>
        </div>
    </section>

    <!-- Core Services -->
    <section class="corporate-band">
        <div class="section-heading">
            <p class="eyebrow">What We Offer</p>
            <h2>Our Core Services</h2>
        </div>

        <div class="services-grid">
            <article class="service-card">
                <div class="service-icon">🔍</div>
                <h3>Candidate Sourcing</h3>
                <p>We identify and attract top talent through our extensive network, advanced sourcing techniques, and industry partnerships.</p>
                <ul class="service-features">
                    <li>Active and passive candidate sourcing</li>
                    <li>AI-powered candidate matching</li>
                    <li>Global talent database access</li>
                    <li>Specialized industry expertise</li>
                </ul>
            </article>

            <article class="service-card">
                <div class="service-icon">📋</div>
                <h3>Screening & Assessment</h3>
                <p>Comprehensive evaluation processes ensure candidates meet your requirements through technical assessments and behavioral interviews.</p>
                <ul class="service-features">
                    <li>Technical skill assessments</li>
                    <li>Behavioral and cultural fit evaluation</li>
                    <li>Background verification</li>
                    <li>Reference checks</li>
                </ul>
            </article>

            <article class="service-card">
                <div class="service-icon">🤝</div>
                <h3>Interview Coordination</h3>
                <p>Streamlined interview scheduling and coordination to ensure smooth communication between candidates and hiring teams.</p>
                <ul class="service-features">
                    <li>Multi-round interview management</li>
                    <li>Calendar integration</li>
                    <li>Interview feedback collection</li>
                    <li>Real-time status updates</li>
                </ul>
            </article>

            <article class="service-card">
                <div class="service-icon">📄</div>
                <h3>Document Management</h3>
                <p>Secure document collection, verification, and management for all recruitment-related paperwork and compliance requirements.</p>
                <ul class="service-features">
                    <li>Resume and portfolio management</li>
                    <li>Document verification services</li>
                    <li>Secure digital storage</li>
                    <li>Compliance documentation</li>
                </ul>
            </article>

            <article class="service-card">
                <div class="service-icon">📊</div>
                <h3>Analytics & Reporting</h3>
                <p>Data-driven insights and comprehensive reporting to help you make informed hiring decisions and optimize your recruitment strategy.</p>
                <ul class="service-features">
                    <li>Recruitment metrics dashboard</li>
                    <li>Time-to-fill analysis</li>
                    <li>Candidate quality tracking</li>
                    <li>Custom reporting solutions</li>
                </ul>
            </article>

            <article class="service-card">
                <div class="service-icon">🎓</div>
                <h3>Campus Recruitment</h3>
                <p>Specialized campus hiring programs to connect with fresh talent from universities and educational institutions worldwide.</p>
                <ul class="service-features">
                    <li>Campus drive coordination</li>
                    <li>University partnerships</li>
                    <li>Fresher training programs</li>
                    <li>Internship placements</li>
                </ul>
            </article>
        </div>
    </section>

    <!-- Industry Specializations -->
    <section class="corporate-band corporate-band--muted">
        <div class="section-heading">
            <p class="eyebrow">Industries We Serve</p>
            <h2>Industry Expertise</h2>
        </div>

        <div class="industry-grid">
            <div class="industry-item">
                <div class="industry-icon">💻</div>
                <h3>Technology & IT</h3>
                <p>Software development, cloud computing, cybersecurity, AI/ML, data science</p>
            </div>
            <div class="industry-item">
                <div class="industry-icon">🏦</div>
                <h3>Banking & Finance</h3>
                <p>FinTech, banking operations, risk management, financial analysis</p>
            </div>
            <div class="industry-item">
                <div class="industry-icon">🏥</div>
                <h3>Healthcare & Life Sciences</h3>
                <p>HealthTech, pharmaceuticals, medical devices, healthcare IT</p>
            </div>
            <div class="industry-item">
                <div class="industry-icon">🛒</div>
                <h3>E-Commerce & Retail</h3>
                <p>Digital marketing, supply chain, customer experience, logistics</p>
            </div>
            <div class="industry-item">
                <div class="industry-icon">🏭</div>
                <h3>Manufacturing</h3>
                <p>Industrial automation, quality assurance, production management</p>
            </div>
            <div class="industry-item">
                <div class="industry-icon">🚗</div>
                <h3>Automotive</h3>
                <p>Electric vehicles, autonomous systems, automotive engineering</p>
            </div>
        </div>
    </section>

    <!-- Hiring Models -->
    <section class="corporate-band">
        <div class="section-heading">
            <p class="eyebrow">Flexible Engagement</p>
            <h2>Hiring Models</h2>
        </div>

        <div class="hiring-models-grid">
            <article class="hiring-model-card">
                <div class="model-badge">Popular</div>
                <h3>Permanent Hiring</h3>
                <p>Find long-term team members who grow with your organization. We handle the entire recruitment lifecycle from sourcing to onboarding.</p>
                <ul class="model-features">
                    <li>Full-time placements</li>
                    <li>Complete recruitment support</li>
                    <li>Replacement guarantee</li>
                    <li>Onboarding assistance</li>
                </ul>
            </article>

            <article class="hiring-model-card">
                <h3>Contract Staffing</h3>
                <p>Flexible staffing solutions for project-based needs, seasonal demands, or specialized skill requirements for defined periods.</p>
                <ul class="model-features">
                    <li>Short and long-term contracts</li>
                    <li>Quick deployment</li>
                    <li>Payroll management</li>
                    <li>Renewal options</li>
                </ul>
            </article>

            <article class="hiring-model-card">
                <h3>Contract-to-Hire</h3>
                <p>Start with a contract arrangement and convert to permanent employment based on performance and business needs.</p>
                <ul class="model-features">
                    <li>Trial period evaluation</li>
                    <li>Flexible conversion terms</li>
                    <li>Risk-free hiring</li>
                    <li>Seamless transition</li>
                </ul>
            </article>

            <article class="hiring-model-card">
                <h3>Executive Search</h3>
                <p>Specialized recruitment for senior-level positions and executive roles requiring confidential and targeted approaches.</p>
                <ul class="model-features">
                    <li>C-level and leadership hiring</li>
                    <li>Confidential searches</li>
                    <li>Market intelligence</li>
                    <li>Negotiation support</li>
                </ul>
            </article>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="corporate-band corporate-band--muted">
        <div class="section-heading">
            <p class="eyebrow">Why VistaWays Tech</p>
            <h2>What Sets Us Apart</h2>
        </div>

        <div class="why-us-grid">
            <div class="why-us-item">
                <div class="why-number">01</div>
                <h3>Technology-Driven</h3>
                <p>Our AI-powered platform ensures faster, more accurate candidate matching and streamlined processes.</p>
            </div>
            <div class="why-us-item">
                <div class="why-number">02</div>
                <h3>Global Reach</h3>
                <p>With presence in multiple countries, we can source talent from anywhere in the world.</p>
            </div>
            <div class="why-us-item">
                <div class="why-number">03</div>
                <h3>Industry Experts</h3>
                <p>Our recruiters specialize in specific industries, understanding your unique hiring needs.</p>
            </div>
            <div class="why-us-item">
                <div class="why-number">04</div>
                <h3>Quality Focus</h3>
                <p>Rigorous screening processes ensure you only meet qualified, vetted candidates.</p>
            </div>
            <div class="why-us-item">
                <div class="why-number">05</div>
                <h3>Transparent Process</h3>
                <p>Real-time updates and clear communication keep you informed at every stage.</p>
            </div>
            <div class="why-us-item">
                <div class="why-number">06</div>
                <h3>Cost-Effective</h3>
                <p>Competitive pricing with flexible engagement models to suit your budget.</p>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-band">
        <div>
            <p class="eyebrow">Get Started</p>
            <h2>Ready to Transform Your Hiring Process?</h2>
        </div>
        <div class="cta-buttons">
            <a class="btn btn-warning btn-lg" asp-controller="Home" asp-action="Contact">Contact Us</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Otp" asp-action="RegisterEmailOtp">Register as Candidate</a>
        </div>
    </section>
</main>
