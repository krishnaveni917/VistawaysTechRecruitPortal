@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">VistaWays Tech - Admin Dashboard</h2>

    <div class="row">

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>@ViewBag.TotalCandidates</h3>
                    <p>Total Candidates</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>@ViewBag.PendingAssessment</h3>
                    <p>Pending Assessments</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>@ViewBag.Interviews</h3>
                    <p>Scheduled Interviews</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>@ViewBag.Offers</h3>
                    <p>Offer Letters</p>
                </div>
            </div>
        </div>

    </div>

    <hr />

    <a asp-action="Candidates" class="btn btn-primary">
        View Candidates
    </a>

</div>